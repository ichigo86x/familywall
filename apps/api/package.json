{
  "name": "@familywall/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npm --prefix ../../packages/shared run build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "start:dev": "npm --prefix ../../packages/shared run build && tsc-watch -p tsconfig.build.json --onSuccess \"node --disable-warning=ExperimentalWarning dist/main.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@familywall/shared": "file:../../packages/shared",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "ical.js": "^2.2.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
