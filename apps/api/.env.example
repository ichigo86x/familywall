PORT=3001
NODE_ENV=development

# SQLite database, encryption key and JWT key live here (created on first run).
DATA_DIR=./data

# Optional overrides. When unset, 32-byte keys are generated into DATA_DIR.
# FAMILYWALL_SECRET_KEY=<base64 32 bytes>
# JWT_SECRET=<base64 32 bytes>
JWT_EXPIRES_IN=30d

# Production: path of the built web app served by the API.
# WEB_DIST_DIR=../web/dist

# Extra CORS origins (comma separated). Development defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173
