{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.check"
  },
  "include": ["src/**/*.ts"]
}